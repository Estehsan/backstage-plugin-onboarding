{
  "name": "@estehsaan/backstage-plugin-onboarding",
  "version": "1.5.1",
  "description": "A structured, interactive onboarding checklist plugin for Backstage",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "onboarding",
    "pluginPackages": [
      "@estehsaan/backstage-plugin-onboarding",
      "@estehsaan/backstage-plugin-onboarding-backend",
      "@estehsaan/backstage-plugin-onboarding-common"
    ]
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "onboarding",
    "checklist",
    "developer-portal"
  ],
  "homepage": "https://github.com/Estehsan/backstage-plugin-onboarding/tree/main/workspaces/onboarding/plugins/onboarding#readme",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "./alpha": {
        "types": "./dist/alpha.d.ts",
        "default": "./dist/alpha.esm.js"
      },
      "./techdocs-editor": {
        "types": "./dist/techdocs-editor.d.ts",
        "default": "./dist/techdocs-editor.esm.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "alpha": [
          "dist/alpha.d.ts"
        ],
        "techdocs-editor": [
          "dist/techdocs-editor.d.ts"
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Estehsan/backstage-plugin-onboarding",
    "directory": "workspaces/onboarding/plugins/onboarding"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "jest": {
    "moduleNameMapper": {
      "style-inject\\.es\\.esm\\.js$": "<rootDir>/test/styleInjectMock.js",
      "\\.css$": "<rootDir>/test/styleModuleMock.js"
    }
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.7.6",
    "@backstage/core-components": "^0.18.7",
    "@backstage/core-plugin-api": "^1.12.3",
    "@backstage/errors": "^1.2.7",
    "@backstage/frontend-plugin-api": "^0.15.0",
    "@backstage/plugin-catalog-react": "^2.0.0",
    "@backstage/plugin-scaffolder-react": "^1.19.7",
    "@backstage/theme": "^0.7.2",
    "@backstage/ui": "^0.16.0",
    "@estehsaan/backstage-plugin-onboarding-common": "^1.5.1",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.9.1",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "@remixicon/react": "^4.2.0",
    "react-use": "^17.2.4",
    "yaml": "^2.0.0"
  },
  "peerDependencies": {
    "@estehsaan/backstage-plugin-techdocs-editor-react": "^2.0.0",
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-router-dom": "6.0.0-beta.0 || ^6.3.0"
  },
  "peerDependenciesMeta": {
    "@estehsaan/backstage-plugin-techdocs-editor-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "@backstage/core-app-api": "^1.19.6",
    "@backstage/dev-utils": "^1.1.0",
    "@backstage/test-utils": "^1.7.16",
    "@estehsaan/backstage-plugin-techdocs-editor-react": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.3.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./alpha": "./src/alpha/index.ts",
    "./techdocs-editor": "./src/techdocs-editor/index.tsx",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "alpha": [
        "src/alpha/index.ts"
      ],
      "techdocs-editor": [
        "src/techdocs-editor/index.tsx"
      ]
    }
  },
  "files": [
    "dist"
  ]
}
